{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/run-event.schema.json",
  "title": "DrRainAI Run Event (Draft) / DrRainAI 运行事件（草案）",
  "description": "DRAFT: envelope for SSE events; no implementation is implied. / 草案：SSE 事件封装，不代表已实现。",
  "type": "object",
  "required": ["event_id", "run_id", "request_id", "type", "occurred_at", "data"],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique within a run if replay is supported. / 若支持重放，则在运行内唯一。"
    },
    "run_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "enum": [
        "run.started",
        "message.delta",
        "tool.started",
        "tool.completed",
        "tool.failed",
        "run.completed",
        "run.failed",
        "run.cancelled"
      ]
    },
    "data": {
      "type": "object",
      "description": "Payload is event-specific; see docs. / 负载依事件类型定义，见合同文档。"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "run.started" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["status"],
            "properties": { "status": { "const": "running" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "message.delta" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["text"],
            "properties": { "text": { "type": "string" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": { "enum": ["tool.started", "tool.completed"] }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["tool_name"],
            "properties": {
              "tool_name": { "type": "string" },
              "summary": {
                "type": "string",
                "description": "Safe, non-sensitive summary. / 安全且不含敏感信息的摘要。"
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "tool.failed" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["tool_name", "error"],
            "properties": {
              "tool_name": { "type": "string" },
              "error": { "$ref": "#/$defs/error" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "run.failed" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["error"],
            "properties": { "error": { "$ref": "#/$defs/error" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "run.completed" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["message_id"],
            "properties": { "message_id": { "type": "string" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "run.cancelled" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["reason"],
            "properties": { "reason": { "type": "string" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string" },
        "message": {
          "type": "string",
          "description": "Safe and non-sensitive. / 安全且不含敏感信息。"
        },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
